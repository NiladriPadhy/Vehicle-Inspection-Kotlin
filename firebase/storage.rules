rules_version = '2';

// Storage rules: authenticated inspectors may upload/read inspection media under their own tree.
// Path hierarchy defined in contracts/storage-contract.md.
service firebase.storage {
  match /b/{bucket}/o {
    match /inspections/{inspectionId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/json');
    }
  }
}
